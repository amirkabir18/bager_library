# Telegram Bot settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_PROXY=

# Cloudflare / Vercel relay support (for restricted networks)
# Set either TELEGRAM_RELAY_URL, CLOUDFLARE_RELAY_URL, or VERCEL_RELAY_URL:
# TELEGRAM_RELAY_URL=https://your-worker.workers.dev
# TELEGRAM_RELAY_URL=https://your-project.vercel.app
# Optional secret for protected relays:
# TELEGRAM_RELAY_SECRET=

# Notification settings
NOTIFICATIONS_ENABLED=true
NOTIFICATION_ADVANCE_DAYS=2
NOTIFICATION_SOUND=true
NOTIFICATION_CHECK_INTERVAL_MINS=30
